# Configure these in Vercel Environment Variables after granting deployment access.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Never commit live values. SUPABASE_SERVICE_ROLE_KEY and RAZORPAY_KEY_SECRET
# must remain server-side and must never have the NEXT_PUBLIC_ prefix.